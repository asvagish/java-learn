// Parent class
class Vehicle {
    String brand;

    void start() {
        System.out.println(brand + " vehicle is starting.");
    }
}

// Child class
class Car extends Vehicle {
    String model;

    void displayDetails() {
        System.out.println("Brand: " + brand);
        System.out.println("Model: " + model);
    }
}

public class Main {
    public static void main(String[] args) {
        Car myCar = new Car();
        myCar.brand = "Toyota";  // inherited field
        myCar.model = "Corolla"; // child class field

        myCar.start();           // parent class method
        myCar.displayDetails();  // child class method
    }
}
